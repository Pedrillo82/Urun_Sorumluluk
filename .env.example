# Anthropic (Claude) API
# https://console.anthropic.com/ üzerinden alınır. Yalnızca sunucu tarafında kullanılır.
ANTHROPIC_API_KEY=sk-ant-...
# Kullanılacak model (opsiyonel). Varsayılan: claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# Supabase (veritabanı + dosya depolama)
# Supabase projesi > Project Settings > API bölümünden alınır.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# DİKKAT: service_role anahtarı gizlidir; yalnızca sunucu tarafında kalmalı, tarayıcıya sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Yüklenen dosyaların saklanacağı Storage bucket adı
SUPABASE_STORAGE_BUCKET=risk-belgeleri
